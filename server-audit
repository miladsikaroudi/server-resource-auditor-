#!/bin/bash
# Server Resource Auditor wrapper
# Usage: server-audit [daily|check|cleanup]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/scripts/audit.py"

MODE="${1:-daily}"

if [ ! -f "$PYTHON_SCRIPT" ]; then
    echo "Error: audit.py not found at $PYTHON_SCRIPT"
    exit 1
fi

python3 "$PYTHON_SCRIPT" "$MODE"
